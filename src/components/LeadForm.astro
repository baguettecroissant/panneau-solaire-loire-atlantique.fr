---
const { city = 'Nantes', compact = false } = Astro.props;
---
<form class="form" method="post" action="/api/lead"><span class="eyebrow">Simulation gratuite</span><h2>{compact ? 'Vérifier ma rentabilité solaire' : `Devis panneaux solaires à ${city}`}</h2><p>Réponse indicative sous 24h par un expert RGE du 44.</p><div class="two"><label>Prénom<input name="prenom" required /></label><label>Nom<input name="nom" required /></label></div><div class="two"><label>Email<input type="email" name="email" required /></label><label>Téléphone<input name="tel" required /></label></div><label>Adresse<input name="adresse" required /></label><div class="two"><label>Code postal<input name="cp" pattern="44[0-9]{3}" required /></label><label>Ville<input name="ville" value={city} required /></label></div><div class="two"><label>Projet<select name="projectType"><option>3 kWc autoconsommation</option><option>6 kWc maison familiale</option><option>9 kWc + PAC/VE</option><option>Batterie LFP</option></select></label><label>Délai<select name="delais"><option value="1">Dès que possible</option><option value="2">Dans les 3 mois</option><option value="3">Plus tard</option></select></label></div><label><input type="checkbox" name="consent" required /> J’accepte d’être recontacté pour mon projet solaire.</label><input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px"/><button class="btn" type="submit">Vérifier ma rentabilité solaire</button></form>

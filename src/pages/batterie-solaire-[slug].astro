---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { communes, cityBlocks, localMetrics, site } from '../data/site';
export function getStaticPaths(){ return communes.map((commune,index)=>({params:{slug:commune.slug},props:{commune,index}})); }
const { commune, index } = Astro.props;
const blocks=cityBlocks(commune,index); const m=localMetrics(commune,index);
const kind = 'batterie';
const h1 = kind==='installateur' ? `Installateur solaire RGE à ${commune.name} (${commune.postalCodes[0]}) — Loire-Atlantique` : kind==='prix' ? `Prix panneaux solaires à ${commune.name} (${commune.postalCodes[0]}) — Budget 2026` : kind==='devis' ? `Devis panneaux solaires à ${commune.name} (${commune.postalCodes[0]}) — Simulation gratuite` : kind==='batterie' ? `Batterie solaire à ${commune.name} (${commune.postalCodes[0]}) — Stockage LFP` : `Panneaux Solaires à ${commune.name} (${commune.postalCodes[0]}) — Expert RGE Loire-Atlantique`;
const title=h1; const description=`${commune.name} : panneaux solaires en Loire-Atlantique, production ${m.yieldPerKwc} kWh/kWc/an, prix 3 à 9 kWc, aides et devis RGE gratuit.`;
---
<BaseLayout title={title} description={description}>
<section class="local-hero"><div class="container"><p class="crumb"><a href="/communes/">Communes</a> / {commune.name}</p><h1>{h1}</h1><p class="lead">Vous souhaitez installer des panneaux solaires à {commune.name} en Loire-Atlantique ? {blocks.intro} Les experts RGE du 44 installent vos panneaux solaires entre 7 500€ et 22 000€ TTC, simulation de rentabilité gratuite.</p><a class="btn" href="#devis">Vérifier ma rentabilité solaire à {commune.name} (44)</a></div></section>
<section class="section"><div class="container two"><article><span class="eyebrow">Analyse locale</span><h2>Toiture, météo et usages à {commune.name}</h2><p>{m.localAngle}</p><p>{m.roofType}</p><p>{blocks.heritage}</p></article><aside class="card"><h3>Production estimée</h3><p class="price">{m.yieldPerKwc} kWh/kWc/an</p><p>6 kWc : <strong>{m.sixKwc.toLocaleString('fr-FR')} kWh/an</strong></p><p>9 kWc : <strong>{m.nineKwc.toLocaleString('fr-FR')} kWh/an</strong></p></aside></div></section>
<section class="section section-white"><div class="container"><span class="eyebrow">Conseil 44</span><h2>Une décision écologique, mais surtout vérifiable.</h2><div class="grid cards"><article class="card"><h3>Aides & EDF OA</h3><p>{blocks.advice}</p></article><article class="card"><h3>ROI</h3><p>{blocks.market}</p></article><article class="card"><h3>PAC + solaire</h3><p>Programmer PAC, ballon, lave-linge ou recharge VE sur les heures solaires améliore la rentabilité.</p></article></div></div></section>
<section class="section"><div class="container"><h2>FAQ solaire à {commune.name}</h2><div class="faq"><details open><summary>Le solaire marche-t-il vraiment en Loire-Atlantique ?</summary><p>Oui. Une installation bien orientée produit avec la luminosité, même par temps variable. L’important est de dimensionner selon vos usages.</p></details><details><summary>Les panneaux se posent-ils sur ardoise ?</summary><p>Oui, en surimposition avec fixations adaptées, calepinage propre et déclaration préalable si nécessaire.</p></details><details><summary>Quelle puissance choisir ?</summary><p>3 kWc pour un talon modéré, 6 kWc pour une maison familiale, 9 kWc pour PAC, VE ou forte consommation.</p></details></div></div></section>
<section id="devis" class="section section-white"><div class="container"><LeadForm city={commune.name}/></div></section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';

const offers = [
  { power:'3 kWc', price:'7 500 à 10 000 €', use:'Maison sobre · 1 à 2 personnes', output:'3 200 à 3 500 kWh/an', note:'Première marche utile pour autoconsommer au quotidien.' },
  { power:'6 kWc', price:'12 500 à 16 500 €', use:'Famille · PAC · véhicule électrique', output:'6 400 à 7 000 kWh/an', note:'Le format le plus étudié pour une maison familiale du 44.', featured:true },
  { power:'9 kWc', price:'16 500 à 22 000 €', use:'Grande maison · usages électriques', output:'9 600 à 10 500 kWh/an', note:'À dimensionner avec précision pour éviter le surplus peu valorisé.' }
];
---
<BaseLayout title="Prix panneaux solaires Loire-Atlantique 2026 — Guide détaillé" description="Prix indicatifs de panneaux solaires en Loire-Atlantique : budgets 3, 6 et 9 kWc, éléments inclus, batterie LFP et méthode pour comparer deux devis.">
  <section class="tarifs-hero">
    <div class="container tarifs-hero-grid">
      <div><span class="kicker kicker-light">Budget photovoltaïque · 2026</span><h1>Le bon prix solaire n’est pas un chiffre. <em>C’est un projet complet.</em></h1><p>Voici des fourchettes réalistes pour une installation résidentielle en Loire-Atlantique : matériel, pose, sécurité, raccordement et mise en service. Elles servent à comparer, pas à remplacer une visite de toiture.</p><div class="tarifs-hero-actions"><a href="#budgets" class="btn btn-large">Comparer les budgets ↓</a><a href="/devis/" class="ghost-link">Obtenir une étude détaillée</a></div><small>Prix indicatifs TTC avant aides éventuelles. Les contraintes de toiture peuvent modifier le devis.</small></div>
      <div class="hero-price-panel"><span>Repère maison nantaise</span><strong>6 kWc</strong><b>12 500–16 500 €</b><p>Modules N-type · pose en surimposition · onduleur ou micro-onduleurs · démarches incluses selon devis.</p><div><i>☀</i><i>⌂</i><i>⚡</i></div></div>
    </div>
  </section>

  <section class="section" id="budgets"><div class="container"><div class="section-head centered"><span class="eyebrow">Comparer à périmètre égal</span><h2>Trois budgets pour comprendre les ordres de grandeur</h2><p>Une installation photovoltaïque ne se compare correctement que si les composants, la toiture, les démarches et les garanties sont explicitement décrits.</p></div><div class="price-comparison">{offers.map(offer => <article class:list={['price-offer', offer.featured && 'price-featured']}><span>{offer.featured ? 'Format le plus fréquent' : 'Repère de puissance'}</span><h3>{offer.power}</h3><strong>{offer.price}</strong><p>{offer.use}</p><hr/><small>Production possible dans le 44</small><b>{offer.output}</b><p class="offer-note">{offer.note}</p><a href="/devis/">Vérifier pour ma toiture →</a></article>)}</div></div></section>

  <section class="budget-factors"><div class="container"><div class="section-head"><span class="eyebrow">Ce qui fait vraiment varier un devis</span><h2>Six lignes à vérifier avant de signer</h2></div><div class="factor-grid"><article><i>⌂</i><h3>Toiture & accès</h3><p>Ardoise, pente, échafaudage, état de la couverture et ombrages déterminent une part concrète du chantier.</p></article><article><i>▦</i><h3>Modules & intégration</h3><p>Puissance des panneaux, structure de fixation, calepinage et ventilation doivent être détaillés.</p></article><article><i>⚡</i><h3>Électronique</h3><p>Micro-onduleurs, onduleur central ou hybride : le choix dépend des orientations et de l’évolution prévue.</p></article><article><i>↔</i><h3>Raccordement</h3><p>Tableau électrique, protection, Consuel et dossier Enedis ne doivent pas être laissés implicites.</p></article><article><i>⌁</i><h3>Pilotage & usages</h3><p>Ballon d’eau chaude, PAC ou recharge de véhicule peuvent améliorer l’autoconsommation sans batterie.</p></article><article><i>✓</i><h3>Garanties & suivi</h3><p>Exigez références exactes, décennale, qualification adaptée, supervision et interlocuteur après pose.</p></article></div></div></section>

  <section class="section scenario"><div class="container scenario-grid"><div class="scenario-image"><img src="/images/guides/prix-solaire-44.webp" alt="Toiture résidentielle équipée de panneaux solaires" loading="lazy"/><span>Cas de figure · à adapter à chaque toiture</span></div><div><span class="eyebrow">Scénario maison nantaise</span><h2>Une famille, une PAC, une toiture ardoise : comment lire le budget ?</h2><p>Pour une maison de 110 à 140 m² avec des consommations régulières en journée, une étude peut comparer 3, 6 et 9 kWc. Le choix ne repose pas sur « le plus grand possible », mais sur la part réellement autoconsommée.</p><div class="scenario-metrics"><div><small>Puissance étudiée</small><strong>6 kWc</strong></div><div><small>Production indicative</small><strong>6,4–7 MWh/an</strong></div><div><small>Budget indicatif</small><strong>12,5–16,5 k€</strong></div></div><p class="muted">Le retour dépend notamment du profil de consommation, du prix de l’électricité, du financement, du productible et de la longévité des composants. Aucun délai de rentabilité ne peut être garanti sans étude détaillée.</p></div></div></section>

  <section class="addons"><div class="container"><div><span class="eyebrow">Options à mettre à part</span><h2>Batterie, carport, entretien : ne les mélangez pas au prix de base.</h2></div><div class="addon-list"><article><span>Batterie LFP 5 à 10 kWh</span><b>4 000–8 000 €</b><small>À comparer au pilotage des usages et au surplus disponible.</small></article><article><span>Carport photovoltaïque</span><b>8 000–15 000 €</b><small>Structure, fondations et ombrage du véhicule à intégrer.</small></article><article><span>Entretien & supervision</span><b>80–150 €/an</b><small>Le suivi de production compte plus qu’un nettoyage automatique.</small></article></div></div></section>

  <section class="lead-section"><div class="container"><div class="section-head centered"><span class="eyebrow">Passer des fourchettes à votre projet</span><h2>Recevez un budget adapté à votre toiture</h2><p>Précisez vos usages, votre type de couverture et votre commune. La demande est vérifiée avant toute mise en relation.</p></div><LeadForm city="Nantes" /></div></section>
</BaseLayout>

<style>
.tarifs-hero{padding:110px 0 95px;background:linear-gradient(120deg,#022c22,#064e3b 58%,#a16207);color:#fff}.tarifs-hero-grid{display:grid;grid-template-columns:1.25fr .65fr;align-items:center;gap:80px}.tarifs-hero h1{max-width:790px}.tarifs-hero h1 em{color:#fcd34d;font-style:normal}.tarifs-hero p{color:#d1fae5;font-size:1.12rem;max-width:730px}.tarifs-hero-actions{display:flex;align-items:center;gap:25px;margin:30px 0}.tarifs-hero small{color:#a7f3d0;font-size:.72rem}.hero-price-panel{padding:35px;border-radius:28px;background:rgba(255,255,255,.97);color:var(--text);box-shadow:0 28px 65px rgba(0,0,0,.25);transform:rotate(1.5deg)}.hero-price-panel>span,.hero-price-panel strong,.hero-price-panel b{display:block}.hero-price-panel>span{font:800 .68rem Onest;text-transform:uppercase;letter-spacing:.08em;color:var(--primary)}.hero-price-panel strong{font:800 3.8rem 'IBM Plex Mono';color:var(--primary-deep);margin-top:15px}.hero-price-panel b{font:800 1.45rem 'IBM Plex Mono';color:var(--secondary);margin:5px 0 18px}.hero-price-panel p{color:var(--text-muted);font-size:.82rem}.hero-price-panel div{display:flex;gap:12px;margin-top:24px}.hero-price-panel i{display:grid;place-items:center;width:38px;height:38px;border-radius:10px;background:var(--primary-light);font-style:normal}.price-comparison{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.price-offer{padding:31px;border:1px solid #d1fae5;border-radius:22px;background:#fff;box-shadow:var(--shadow-sm)}.price-offer>span{color:var(--primary);font:800 .64rem Onest;text-transform:uppercase;letter-spacing:.08em}.price-offer h3{font-size:2rem;margin:20px 0 7px}.price-offer>strong{color:var(--primary-deep);font:800 1.35rem 'IBM Plex Mono'}.price-offer>p{font-size:.84rem;color:var(--text-muted);min-height:27px}.price-offer hr{border:0;border-top:1px solid #d1fae5;margin:25px 0}.price-offer small{display:block;color:var(--text-muted);font-size:.7rem}.price-offer>b{font:800 1rem 'IBM Plex Mono';color:var(--primary)}.price-offer .offer-note{min-height:50px;margin:17px 0}.price-offer>a{font-size:.78rem;font-weight:900;color:var(--primary)}.price-featured{background:var(--primary-deep);border-color:var(--primary-deep);transform:translateY(-13px)}.price-featured>*:not(p){color:#fff}.price-featured>span,.price-featured>b,.price-featured>a{color:#fcd34d}.price-featured p,.price-featured small{color:#d1fae5}.price-featured hr{border-color:rgba(255,255,255,.15)}.budget-factors{padding:100px 0;background:#ecfdf5}.factor-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.factor-grid article{padding:26px;background:#fff;border-radius:18px;border:1px solid #d1fae5}.factor-grid i{display:grid;place-items:center;width:45px;height:45px;border-radius:12px;background:#d1fae5;color:var(--primary);font-style:normal;font-size:1.25rem}.factor-grid h3{font-size:1.05rem;margin:17px 0 8px}.factor-grid p{color:var(--text-muted);font-size:.84rem;margin:0}.scenario-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:80px;align-items:center}.scenario-image{position:relative}.scenario-image img{width:100%;height:460px;object-fit:cover;border-radius:24px}.scenario-image span{position:absolute;bottom:17px;left:17px;background:#fff;border-radius:99px;padding:8px 12px;color:var(--primary);font:800 .65rem Onest}.scenario h2{font-size:2.6rem}.scenario>p{color:var(--text-muted)}.scenario-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:28px 0}.scenario-metrics div{padding:16px;background:#f0fdf4;border-radius:13px}.scenario-metrics small,.scenario-metrics strong{display:block}.scenario-metrics small{font-size:.63rem;color:var(--text-muted)}.scenario-metrics strong{font:800 .92rem 'IBM Plex Mono';color:var(--primary)}.muted{font-size:.8rem!important}.addons{padding:75px 0;background:#020617;color:#fff}.addons>.container{display:grid;grid-template-columns:.75fr 1.25fr;gap:75px;align-items:center}.addons h2{font-size:2.25rem}.addon-list{display:grid;gap:10px}.addon-list article{display:grid;grid-template-columns:1fr auto;gap:5px 25px;padding:18px 20px;border:1px solid rgba(255,255,255,.15);border-radius:14px}.addon-list span{font:700 .9rem Onest}.addon-list b{color:#fcd34d;font:800 .9rem 'IBM Plex Mono'}.addon-list small{grid-column:1/-1;color:#cbd5e1;font-size:.73rem}@media(max-width:900px){.tarifs-hero-grid,.scenario-grid,.addons>.container{grid-template-columns:1fr;gap:45px}.price-comparison,.factor-grid{grid-template-columns:1fr}.price-featured{transform:none}.tarifs-hero{padding:70px 0}.scenario-image img{height:300px}}@media(max-width:560px){.tarifs-hero-actions{align-items:stretch;flex-direction:column}.hero-price-panel{transform:none}.scenario-metrics{grid-template-columns:1fr}.addon-list article{grid-template-columns:1fr}.addon-list b{grid-column:1}.addons{padding:60px 0}}
</style>

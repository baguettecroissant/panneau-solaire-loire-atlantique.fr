---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guides } from '../../data/guides';
---
<BaseLayout title="Guides panneaux solaires Loire-Atlantique — Prix, aides, PAC et batterie" description="Huit guides complets sur les panneaux solaires à Nantes et dans le 44 : prix 2026, production, autoconsommation, aides, PAC, ardoise, batterie et RGE."><section class="page-hero guide-index-hero"><div class="container"><span class="kicker kicker-light">Bibliothèque solaire du 44</span><h1>Décider avec des données,<br/>pas avec un discours commercial.</h1><p class="lead">Huit guides pratiques pour comprendre votre toiture, les prix, les aides et les technologies avant de demander un devis.</p></div></section><section class="section"><div class="container guide-index-grid">{guides.map((guide,index)=><a class={index===0?'guide-index-card featured':''||'guide-index-card'} href={`/guides/${guide.slug}/`}><div class="guide-image"><img src={guide.image} alt={guide.title} loading={index>2?'lazy':'eager'}/><span>{guide.category}</span></div><div><small>{guide.readTime} · Guide 2026</small><h2>{guide.title}</h2><p>{guide.intro}</p><b>Lire le guide complet →</b></div></a>)}</div></section></BaseLayout>

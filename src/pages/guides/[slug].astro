---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { guides } from '../../data/guides';
export function getStaticPaths(){return guides.map((guide,index)=>({params:{slug:guide.slug},props:{guide,index}}));}
const { guide, index } = Astro.props;
const related = guides.filter((g)=>g.slug!==guide.slug).slice(index%3,index%3+3);
const schema={'@context':'https://schema.org','@type':'Article',headline:guide.title,image:`https://panneau-solaire-loire-atlantique.fr${guide.image}`,author:{'@type':'Organization',name:'Panneau Solaire Loire-Atlantique'},mainEntityOfPage:`https://panneau-solaire-loire-atlantique.fr/guides/${guide.slug}/`};
---
<BaseLayout title={guide.title} description={guide.description} schema={schema}>
  <section class="article-hero"><div class="container article-hero-grid"><div><nav class="crumb"><a href="/">Accueil</a><span>›</span><a href="/guides/">Guides</a><span>›</span>{guide.shortTitle}</nav><span class="kicker kicker-light">{guide.category} · {guide.readTime}</span><h1>{guide.title}</h1><p>{guide.intro}</p><div class="article-meta"><span>✓ Mis à jour en 2026</span><span>✓ Données Loire-Atlantique</span><span>✓ Lecture sans jargon commercial</span></div></div><img src={guide.image} alt={guide.title} width="1400" height="933"/></div></section>
  <section class="section article-section"><div class="container article-layout"><aside class="article-toc"><strong>Dans ce guide</strong><ol>{guide.sections.map((s,i)=><li><a href={`#section-${i+1}`}>{s.heading}</a></li>)}</ol><a class="btn" href="/devis/">Étudier mon projet</a></aside><article class="article-body"><div class="article-intro"><span>En bref</span><p>{guide.intro}</p></div>{guide.sections.map((s,i)=><section id={`section-${i+1}`}><div class="section-number">0{i+1}</div><h2>{s.heading}</h2>{s.paragraphs.map(p=><p>{p}</p>)}{s.bullets&&<ul class="premium-list">{s.bullets.map(b=><li>{b}</li>)}</ul>}{i===1 && <div class="article-cta"><div><strong>Votre maison est-elle adaptée ?</strong><span>Recevez une estimation de production à partir de votre toiture.</span></div><a href="/devis/">Simulation gratuite →</a></div>}</section>)}<section class="article-faq"><span class="kicker">Questions fréquentes</span><h2>Ce qu’il faut retenir</h2><div class="faq">{guide.faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></section></article></div></section>
  <section class="section soft-section"><div class="container"><div class="section-head split"><div><span class="kicker">À lire ensuite</span><h2>Approfondir votre projet solaire</h2></div><a class="text-link" href="/guides/">Tous les guides →</a></div><div class="related-guides">{related.map(g=><a href={`/guides/${g.slug}/`}><img src={g.image} alt={g.shortTitle} loading="lazy"/><div><span>{g.category}</span><strong>{g.title}</strong><small>Lire en {g.readTime} →</small></div></a>)}</div></div></section>
  <section class="section lead-section"><div class="container"><LeadForm compact={true}/></div></section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import SolarCalculator from '../components/SolarCalculator.astro';
import LeadForm from '../components/LeadForm.astro';
import { guides } from '../data/guides';
const guide=guides.find(g=>g.slug==='solaire-fonctionne-t-il-a-nantes')!;
---
<BaseLayout title="Le solaire fonctionne dans le Grand Ouest — Données Nantes et Loire-Atlantique" description="Production photovoltaïque à Nantes : lumière diffuse, rendement, 1 800 h de soleil, simulation 3 à 9 kWc et conseils pour toiture ardoise."><section class="article-hero"><div class="container article-hero-grid"><div><span class="kicker kicker-light">Guide solaire Grand Ouest</span><h1>Oui, le solaire fonctionne à Nantes.</h1><p>{guide.intro}</p><a class="btn" href="#simulateur">Tester ma toiture ↓</a></div><img src={guide.image} alt="Panneaux solaires produisant sous un ciel nantais variable"/></div></section><section class="section" id="simulateur"><div class="container"><div class="section-head"><span class="kicker">Preuve par les chiffres</span><h2>Simulez production, ROI et PAC + solaire.</h2></div><SolarCalculator city="Nantes" yieldPerKwc={1100}/></div></section><section class="section soft-section"><article class="container article-body">{guide.sections.map((s,i)=><section><div class="section-number">0{i+1}</div><h2>{s.heading}</h2>{s.paragraphs.map(p=><p>{p}</p>)}{s.bullets&&<ul class="premium-list">{s.bullets.map(b=><li>{b}</li>)}</ul>}</section>)}</article></section><section class="section lead-section"><div class="container"><LeadForm compact={true}/></div></section></BaseLayout>

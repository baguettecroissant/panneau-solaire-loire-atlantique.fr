---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { guides } from '../data/guides';
const guide=guides.find(g=>g.slug==='aides-financieres-solaire-2026-loire-atlantique')!;
---
<BaseLayout title="Aides panneaux solaires Loire-Atlantique 2026 — Prime, TVA et EDF OA" description="Guide complet des aides solaires 2026 dans le 44 : prime autoconsommation, TVA, EDF OA, Enedis, Nantes Métropole et vigilance MaPrimeRénov'."><section class="article-hero"><div class="container article-hero-grid"><div><span class="kicker kicker-light">Aides solaires 2026 · Loire-Atlantique</span><h1>Financer sans compter sur une aide imaginaire.</h1><p>{guide.intro}</p><a class="btn" href="#aides">Comprendre les dispositifs ↓</a></div><img src={guide.image} alt="Dossier d'aides financières pour panneaux solaires"/></div></section><section class="section" id="aides"><article class="container article-body">{guide.sections.map((s,i)=><section><div class="section-number">0{i+1}</div><h2>{s.heading}</h2>{s.paragraphs.map(p=><p>{p}</p>)}{s.bullets&&<ul class="premium-list">{s.bullets.map(b=><li>{b}</li>)}</ul>}</section>)}</article></section><section class="section lead-section"><div class="container"><LeadForm compact={true}/></div></section></BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import SolarCalculator from '../components/SolarCalculator.astro';
import { communes } from '../data/site';
import { guides } from '../data/guides';
const featured = communes.slice(0, 11);
const schema = {'@context':'https://schema.org','@type':'Organization',name:'Panneau Solaire Loire-Atlantique',url:'https://panneau-solaire-loire-atlantique.fr',areaServed:'Loire-Atlantique'};
---
<BaseLayout title="Panneaux Solaires Loire-Atlantique (44) — Experts RGE & Devis 2026" description="Étude panneaux solaires en Loire-Atlantique : production réelle à Nantes, prix 3 à 9 kWc, aides 2026, PAC, batterie et devis QualiPV RGE gratuit." schema={schema}>
  <section class="home-hero">
    <img class="home-hero-bg" src="/images/hero-panneau-solaire-loire-atlantique.webp" alt="Maison avec panneaux solaires dans un paysage vert de Loire-Atlantique" width="1920" height="1278" fetchpriority="high"/>
    <div class="hero-overlay"></div><div class="wind-pattern" aria-hidden="true"></div>
    <div class="container home-hero-grid">
      <div class="hero-copy">
        <div class="hero-pill">☀️ Même à Nantes, le solaire est rentable — la preuve en chiffres</div>
        <h1>Panneaux solaires en <span>Loire-Atlantique.</span></h1>
        <p>Produisez une électricité locale sur votre toiture, même sous le ciel nantais. Étude de rentabilité, installateur QualiPV RGE et accompagnement de Nantes à Saint-Nazaire.</p>
        <div class="hero-actions"><a class="btn btn-large" href="/devis/">Estimer mon projet solaire <span>→</span></a><a class="video-link" href="#preuve"><i>▶</i> Pourquoi ça fonctionne ici</a></div>
        <div class="hero-reassurance"><span>✓ Étude gratuite</span><span>✓ Sans engagement</span><span>✓ Données sécurisées</span></div>
      </div>
      <div class="hero-data-card">
        <div class="data-card-top"><span>Production estimée · Nantes</span><b>EN DIRECT</b></div>
        <div class="sun-gauge"><div class="gauge-orbit"><i>☀️</i></div><strong>6 600</strong><span>kWh/an pour 6 kWc</span></div>
        <div class="chart-bars"><i style="height:32%"></i><i style="height:44%"></i><i style="height:63%"></i><i style="height:79%"></i><i style="height:91%"></i><i style="height:100%"></i><i style="height:97%"></i><i style="height:86%"></i><i style="height:68%"></i><i style="height:51%"></i><i style="height:36%"></i><i style="height:28%"></i></div>
        <div class="chart-months"><span>Jan</span><span>Mars</span><span>Mai</span><span>Juil</span><span>Sept</span><span>Nov</span></div>
        <div class="data-card-foot"><div><small>Autoconsommation</small><strong>58%</strong></div><div><small>ROI indicatif</small><strong>9–11 ans</strong></div><div><small>CO₂ évité / an</small><strong>≈ 320 kg</strong></div></div>
      </div>
    </div>
    <div class="hero-stats container"><div><strong>1 800 h</strong><span>de soleil par an</span></div><div><strong>22%</strong><span>rendement N-type</span></div><div><strong>6 600 kWh</strong><span>produits avec 6 kWc</span></div><div><strong>79 communes</strong><span>couvertes dans le 44</span></div></div>
  </section>

  <section class="trust-strip"><div class="container"><strong>Une étude basée sur des technologies reconnues</strong><span>QUALIPV RGE</span><span>ENPHASE IQ8</span><span>MODULES N-TYPE</span><span>ENEDIS</span><span>EDF OA</span></div></section>

  <section class="section proof-section" id="preuve"><div class="container"><div class="section-head centered"><span class="kicker">La preuve par les chiffres</span><h2>Le solaire fonctionne dans le Grand Ouest.<br/><em>Et souvent mieux qu’on l’imagine.</em></h2><p>Les panneaux utilisent la luminosité, pas la chaleur. Le climat tempéré limite les pertes de rendement liées à la surchauffe.</p></div><div class="proof-grid"><article class="proof-photo"><img src="/images/guides/solaire-nantes.webp" alt="Panneaux photovoltaïques produisant en Loire-Atlantique" loading="lazy" width="1400" height="932"/><div><span>Journée variable à Nantes</span><strong>La production continue sous les nuages</strong></div></article><article class="proof-card"><i>01</i><span class="icon-box">☀️</span><h3>Rayonnement diffus</h3><p>Les cellules captent aussi la lumière répartie par la couverture nuageuse. Une journée grise n’est pas une journée à zéro.</p><strong>15–35% <small>de la puissance possible sous ciel couvert</small></strong></article><article class="proof-card"><i>02</i><span class="icon-box">🌡️</span><h3>Température favorable</h3><p>Un module perd du rendement lorsqu’il chauffe fortement. L’air plus frais de l’Atlantique aide à contenir ces pertes.</p><strong>-0,30% <small>environ par °C au-dessus du standard</small></strong></article></div></div></section>

  <section class="section tools-section"><div class="container"><div class="section-head split"><div><span class="kicker">Votre maison, vos chiffres</span><h2>Simulez avant de décider.</h2></div><p>Quatre outils pour comprendre la production, le retour sur investissement, le duo PAC + solaire et les différences dans le département.</p></div><SolarCalculator city="Nantes" yieldPerKwc={1100}/></div></section>

  <section class="section process-section"><div class="container"><div class="section-head centered"><span class="kicker">Un projet simple et contrôlé</span><h2>De votre facture à la première production.</h2></div><div class="process-road"><article><span>01</span><i>📋</i><h3>Étude gratuite</h3><p>Toiture, consommation, PAC, VE et objectifs.</p></article><b>→</b><article><span>02</span><i>📐</i><h3>Conception</h3><p>Calepinage, ombres, choix des modules et onduleurs.</p></article><b>→</b><article><span>03</span><i>🛠️</i><h3>Pose RGE</h3><p>Installation, protections et démarches administratives.</p></article><b>→</b><article><span>04</span><i>📱</i><h3>Suivi</h3><p>Monitoring, autoconsommation et vente du surplus.</p></article></div></div></section>

  <section class="section pricing-home"><div class="container"><div class="pricing-intro"><span class="kicker kicker-light">Budgets 2026</span><h2>Des prix lisibles.<br/>Pas de fausse remise.</h2><p>Une fourchette réaliste permet de repérer immédiatement les offres trop belles pour être vraies ou anormalement chères.</p><a class="text-link light" href="/tarifs/">Voir tous les tarifs et options →</a></div><div class="price-stack"><article><div><span>Essentiel</span><h3>3 kWc</h3><p>8 panneaux · maison sobre</p></div><strong>7 500–10 000 €</strong></article><article class="featured"><em>Le plus choisi</em><div><span>Familial</span><h3>6 kWc</h3><p>16 panneaux · PAC / télétravail</p></div><strong>12 500–16 500 €</strong></article><article><div><span>Évolutif</span><h3>9 kWc</h3><p>24 panneaux · PAC + VE</p></div><strong>16 500–22 000 €</strong></article></div></div></section>

  <section class="section local-zone"><div class="container"><div class="section-head split"><div><span class="kicker">Ancrage local</span><h2>Une étude adaptée à chaque territoire du 44.</h2></div><p>Ardoise nantaise, vent de l’estuaire, villa de la côte ou pavillon du vignoble : les contraintes changent, la méthode reste mesurable.</p></div><div class="city-showcase">{featured.slice(0,6).map((city,index) => <a class={index===0 ? 'city-featured' : ''} href={`/panneau-solaire-${city.slug}/`}><span>{city.postalCodes[0]}</span><h3>{city.name}</h3><p>{city.profile}</p><small>Étude locale →</small></a>)}</div><div class="city-pills">{featured.slice(6).map(city => <a href={`/panneau-solaire-${city.slug}/`}>📍 {city.name}</a>)}<a class="all-cities" href="/communes/">Voir les 79 communes →</a></div></div></section>

  <section class="section guide-home"><div class="container"><div class="section-head split"><div><span class="kicker">Bibliothèque solaire</span><h2>Comprendre avant d’investir.</h2></div><a class="text-link" href="/guides/">Voir les 8 guides →</a></div><div class="guide-grid">{guides.slice(0,4).map((guide,index) => <a class={index===0 ? 'guide-card guide-main' : 'guide-card'} href={`/guides/${guide.slug}/`}><img src={guide.image} alt={guide.title} loading="lazy"/><div><span>{guide.category} · {guide.readTime}</span><h3>{guide.title}</h3><p>{guide.intro}</p><b>Lire le guide →</b></div></a>)}</div></div></section>

  <section class="section green-manifesto"><div class="container"><div class="manifesto-image"><img src="/images/guides/transition-energie.webp" alt="Transition énergétique et paysage durable" loading="lazy" width="1400" height="933"/><span>Nantes · Capitale Verte Européenne 2013</span></div><div><span class="kicker kicker-light">Nantes Capitale Verte</span><h2>Une écologie utile, suivie et rentable.</h2><p>Produire sur sa toiture ne remplace pas la sobriété. Cela la complète : équipements efficaces, usages pilotés, suivi des données et investissement dimensionné sur 25 ans.</p><ul class="check-list"><li>Production locale sans bruit</li><li>Compatibilité PAC et mobilité électrique</li><li>Monitoring précis des performances</li><li>Matériel réparable et garanties documentées</li></ul><a class="btn" href="/guide-solaire-grand-ouest/">Découvrir notre méthode →</a></div></div></section>

  <section class="section lead-section"><div class="container"><LeadForm city="Nantes" compact={true}/></div></section>
</BaseLayout>

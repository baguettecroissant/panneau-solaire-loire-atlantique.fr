---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { communes, site } from '../data/site';
const top=communes.slice(0,8);
const schema={ '@context':'https://schema.org','@type':'LocalBusiness', name:site.name, url:site.url, areaServed:'Loire-Atlantique' };
---
<BaseLayout title="Panneaux Solaires Loire-Atlantique (44) — Experts RGE & Devis 2026" description="Panneaux solaires à Nantes et en Loire-Atlantique : prix 3 à 9 kWc, autoconsommation, PAC + solaire, aides 2026 et devis RGE gratuit." schema={schema}>
<section class="hero"><div class="container hero-grid"><div><span class="badge">Même à Nantes, le solaire est rentable — preuve en chiffres</span><h1>Panneaux solaires en Loire-Atlantique,<br/><em>transition verte mesurable.</em></h1><p class="lead">Maison nantaise, toiture ardoise, PAC, véhicule électrique : dimensionnez votre installation photovoltaïque avec des données réalistes du Grand Ouest.</p><p><a class="btn" href="/devis/">Recevoir mon étude gratuite →</a> <a class="btn secondary" href="/guides/solaire-fonctionne-t-il-a-nantes/">Voir les preuves</a></p></div><div class="hero-card"><div class="sun"></div><h3>Scénario Nantes · 6 kWc</h3><p class="mono">≈ 6 600 kWh/an · ROI 9–11 ans · PAC compatible</p></div></div><div class="container stats"><div class="stat"><strong>1 800h</strong><span>soleil/an suffisant</span></div><div class="stat"><strong>6 kWc</strong><span>maison familiale</span></div><div class="stat"><strong>55–65%</strong><span>couverture possible</span></div><div class="stat"><strong>{communes.length}</strong><span>communes 44</span></div></div></section>
<section class="section"><div class="container"><span class="eyebrow">Écologie pragmatique</span><h2>Le solaire fonctionne aussi dans le Grand Ouest.</h2><div class="grid cards"><article class="card"><h3>Production par luminosité</h3><p>Les panneaux produisent avec la lumière, pas uniquement avec la chaleur. Le climat tempéré limite même certaines pertes liées à la surchauffe.</p></article><article class="card"><h3>PAC + solaire</h3><p>Le duo pertinent en Loire-Atlantique : la production de journée alimente chauffage d’intersaison, rafraîchissement et eau chaude pilotée.</p></article><article class="card"><h3>Ardoise & intégration</h3><p>Surimposition propre, modules noirs, passages discrets et déclaration préalable adaptée aux maisons nantaises.</p></article></div></div></section>
<section class="section section-white"><div class="container"><span class="eyebrow">Prix 2026</span><h2>Budgets réalistes en Loire-Atlantique.</h2><div class="grid cards"><article class="card"><h3>3 kWc</h3><p class="price">7 500–10 000€</p><p>Autoconsommation maison moyenne.</p></article><article class="card"><h3>6 kWc</h3><p class="price">12 500–16 500€</p><p>Maison familiale, ballon, PAC ou télétravail.</p></article><article class="card"><h3>9 kWc</h3><p class="price">16 500–22 000€</p><p>Grande maison, PAC, véhicule électrique.</p></article></div></div></section>
<section class="section"><div class="container"><span class="eyebrow">Communes couvertes</span><h2>De Nantes à Saint-Nazaire, du vignoble au littoral.</h2><div class="city-grid">{top.map(c=><a class="city" href={`/panneau-solaire-${c.slug}/`}><h3>{c.name}</h3><p>{c.postalCodes[0]} · étude solaire locale</p></a>)}</div><p><a class="btn secondary" href="/communes/">Toutes les communes</a></p></div></section>
<section class="section section-white"><div class="container"><LeadForm compact={true}/></div></section>
</BaseLayout>
